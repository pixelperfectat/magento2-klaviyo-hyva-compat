<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Klaviyo\Reclaim\Block\Initialize;
use Magento\Framework\Escaper;
use PixelPerfect\KlaviyoHyvaCompat\ViewModel\KlaviyoTracking;

/** @var Initialize $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$klaviyoKey = $block->getPublicApiKey();

if (!$block->isKlaviyoEnabled() || !$klaviyoKey) {
    return;
}

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var KlaviyoTracking $klaviyoTracking */
$klaviyoTracking = $viewModels->require(KlaviyoTracking::class);
$klaviyoSrc = $klaviyoTracking->getSdkUrl($klaviyoKey);
?>

<div x-data="klaviyoCustomerTracking"
     @private-content-loaded.window="onPrivateContentLoaded">
</div>

<script>
    // Default consent check, based on Magento's cookie restriction mode. A consent manager takes
    // over by defining window.klaviyoConsentGranted before this script runs (see README).
    window.klaviyoConsentGranted = window.klaviyoConsentGranted || function() {
        if (!<?= $klaviyoTracking->isCookieRestrictionEnabled() ? 'true' : 'false' ?>) {
            return true;
        }
        var cookie = hyva.getCookie('user_allowed_save_cookie');
        if (!cookie) {
            return false;
        }
        try {
            return JSON.parse(decodeURIComponent(cookie))[window.CURRENT_WEBSITE_ID] === 1;
        } catch (e) {
            return false;
        }
    };

    // Load Klaviyo CDN script only if consent is granted
    function klaviyoLoadCdn() {
        if (document.querySelector('script[src*="klaviyo.js"]')) {
            return;
        }
        var s = document.createElement('script');
        s.type = 'application/javascript';
        s.async = true;
        s.src = '<?= $escaper->escapeJs($klaviyoSrc) ?>';
        document.head.appendChild(s);
    }

    if (window.klaviyoConsentGranted()) {
        klaviyoLoadCdn();
    }

    ['cookie-consent-updated', 'user-allowed-save-cookie'].forEach(function(eventName) {
        window.addEventListener(eventName, function() {
            if (window.klaviyoConsentGranted()) {
                klaviyoLoadCdn();
            }
        });
    });

    // Klaviyo's documented queue stub: method calls such as isIdentified() and identify() are
    // queued in window._klOnsite and replayed once the async klaviyo.js has loaded.
    function klaviyoQueue() {
        if (!window.klaviyo) {
            window._klOnsite = window._klOnsite || [];
            try {
                window.klaviyo = new Proxy({}, {
                    get: function(target, method) {
                        if (method === 'push') {
                            return function() {
                                window._klOnsite.push.apply(window._klOnsite, arguments);
                            };
                        }
                        return function() {
                            var args = Array.prototype.slice.call(arguments);
                            var callback = typeof args[args.length - 1] === 'function' ? args.pop() : undefined;
                            return new Promise(function(resolve) {
                                window._klOnsite.push([method].concat(args, [function(result) {
                                    if (callback) {
                                        callback(result);
                                    }
                                    resolve(result);
                                }]));
                            });
                        };
                    }
                });
            } catch (e) {
                window.klaviyo = window.klaviyo || [];
                window.klaviyo.push = function() {
                    window._klOnsite.push.apply(window._klOnsite, arguments);
                };
            }
        }
        return window.klaviyo;
    }

    function initKlaviyoCustomerTracking() {
        return {
            identifyDispatched: false,

            onPrivateContentLoaded(event) {
                const customer = event.detail && event.detail.data && event.detail.data.customer;

                if (!customer || !customer.email) {
                    return;
                }

                if (window.klaviyoConsentGranted()) {
                    this.identifyCustomer(customer);
                    return;
                }

                const consentEvents = ['cookie-consent-updated', 'user-allowed-save-cookie'];
                const identifyOnConsent = () => {
                    if (!window.klaviyoConsentGranted()) {
                        return;
                    }
                    consentEvents.forEach((name) => window.removeEventListener(name, identifyOnConsent));
                    this.identifyCustomer(customer);
                };
                consentEvents.forEach((name) => window.addEventListener(name, identifyOnConsent));
            },

            identifyCustomer(customer) {
                if (this.identifyDispatched) {
                    return;
                }
                this.identifyDispatched = true;

                const profile = {
                    '$email': customer.email,
                    '$first_name': customer.firstname || '',
                    '$last_name': customer.lastname || ''
                };
                const klaviyo = klaviyoQueue();

                if (typeof klaviyo.isIdentified !== 'function') {
                    klaviyo.push(['identify', profile]);
                    return;
                }

                klaviyo.isIdentified().then((identified) => {
                    if (!identified) {
                        klaviyo.identify(profile);
                    }
                });
            }
        };
    }

    if (window.Alpine && typeof window.Alpine.data === 'function') {
        window.Alpine.data('klaviyoCustomerTracking', initKlaviyoCustomerTracking);
    } else {
        document.addEventListener('alpine:init', () => {
            window.Alpine.data('klaviyoCustomerTracking', initKlaviyoCustomerTracking);
        }, { once: true });
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>
