{
    "name": "pixelperfectat/magento2-klaviyo-hyva-compat",
    "description": "Hyvä Theme compatibility for Klaviyo_Reclaim: CSP-safe Alpine.js templates for customer identification, product view tracking and the cart refresh ping.",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "magento2-module",
        "hyva",
        "hyva-themes",
        "klaviyo",
        "alpinejs",
        "csp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "PixelPerfect",
            "homepage": "https://github.com/pixelperfectat"
        }
    ],
    "support": {
        "issues": "https://github.com/pixelperfectat/magento2-klaviyo-hyva-compat/issues",
        "source": "https://github.com/pixelperfectat/magento2-klaviyo-hyva-compat"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "hyva-themes/magento2-compat-module-fallback": "^1.0",
        "klaviyo/magento2-extension": "^4.4 || ^5.0",
        "magento/framework": "^103.0"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hyva-themes/magento2-compat-module-fallback.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hyva-themes/magento2-theme-module.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "PixelPerfect\\KlaviyoHyvaCompat\\": "src/"
        },
        "files": [
            "src/registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PixelPerfect\\KlaviyoHyvaCompat\\Test\\": "Test/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test",
            "@infection"
        ],
        "ci:normalize": "@composer normalize --dry-run --diff",
        "ci:validate": "@composer validate --no-check-publish",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "infection": "infection --with-uncovered --min-msi=85 --min-covered-msi=90 --threads=max",
        "lint": "parallel-lint --exclude vendor --exclude generated .",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
